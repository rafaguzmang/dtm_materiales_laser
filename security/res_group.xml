<odoo>
   <record id="module_category_dtm_materiales_laser" model="ir.module.category">
       <field name="name">Corte Laser</field>
       <field name="description">Ayuda para administrar permisos</field>
       <field name="sequence">10</field>
   </record>

   <record id="group_dtm_materiales_laser_admin" model="res.groups">
       <field name="name">Corte Laser Admin</field>
       <field name="category_id" ref="module_category_dtm_materiales_laser"/>
       <field name="implied_ids"  eval="[(4,ref('base.group_user'))]"/>
       <field name="users" eval="[(4, ref('base.user_admin'))]"/>
   </record>

   <record id="group_dtm_materiales_laser_user" model="res.groups">
       <field name="name">Corte Laser User</field>
       <field name="category_id" ref="module_category_dtm_materiales_laser"/>
       <field name="implied_ids"  eval="[(4,ref('base.group_user'))]"/>
   </record>

</odoo>
